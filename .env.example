# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# PostgreSQL connection string
DATABASE_URL="postgresql://username:password@localhost:5432/milk_reception_db"

# Session signing key. Production requires >= 32 random characters:
#   openssl rand -base64 48
JWT_SECRET="replace-with-output-of-openssl-rand-base64-48"

# ---------------------------------------------------------------------------
# Networking / deployment
# ---------------------------------------------------------------------------

# Public URL users reach the app on (used for the cross-origin request check)
APP_URL="http://localhost:3000"
# Extra comma-separated origins allowed to call the API (optional)
ALLOWED_ORIGINS=""
# Set to true only when running behind a reverse proxy that sets X-Forwarded-* headers
TRUST_PROXY="false"
# Session cookies are Secure in production by default. Set to false ONLY for a closed
# intranet served over plain HTTP.
SESSION_COOKIE_SECURE=""

# ---------------------------------------------------------------------------
# First-run bootstrap (production seed: `npx prisma db seed` with NODE_ENV=production)
# Creates this Super Admin only when no active Super Admin exists.
# ---------------------------------------------------------------------------
BOOTSTRAP_ADMIN_USERNAME="admin.superuser"
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_EMAIL=""

# ---------------------------------------------------------------------------
# Optional features
# ---------------------------------------------------------------------------

# Demo sign-in shortcuts on the login page (on automatically under `npm run dev`).
# Never enable against real data: it publishes the demo accounts' passwords.
ENABLE_DEMO_LOGIN="false"

# Shared secret for scheduler calls to /api/cron/* (Authorization: Bearer <secret>).
# Leave empty to disable cron endpoints.
CRON_SECRET=""

# Outbound SMS gateway for MOT collection receipts (HTTPS JSON POST {to, message, sender}).
# Leave SMS_PROVIDER_URL empty to keep messages queued as PENDING.
SMS_PROVIDER_URL=""
SMS_PROVIDER_TOKEN=""
SMS_SENDER_ID=""

# Lets an unattended yard monitor open /tv-board?key=<value> without signing in.
# Leave empty to require sign-in for the board.
TV_BOARD_ACCESS_KEY=""

# Web Push public key (inlined into the browser bundle at build time)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# ---------------------------------------------------------------------------
# docker-compose only
# ---------------------------------------------------------------------------
POSTGRES_USER="milk"
POSTGRES_PASSWORD=""
POSTGRES_DB="milk_reception_db"
APP_PORT="3000"
